# =============================================================================
# LPU Placement Intelligence Platform - Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust variables for your target deployment environment.

# Server Configuration
PORT=5000
HOST=127.0.0.1
FLASK_ENV=development
DEBUG=True

# Security & Session Authentication
# IMPORTANT: Generate a strong 32+ byte random secret key for production deployments
AUTH_SECRET_KEY=lpu_placement_intelligence_super_secret_demo_key_2026_change_in_prod

# Persistence Database Configuration
# Default is local SQLite. For production, specify PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/lpu_placement_db
DATABASE_PATH=data/assessment_history.db

# Cross-Origin Resource Sharing (CORS)
# Set to specific frontend origin in production (e.g., https://placement.university.edu)
CORS_ORIGIN=*

# Machine Learning Artifacts Directory
MODELS_DIR=models

